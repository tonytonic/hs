# Cloudflare Pages — _headers
# Offline Safari fix : pas de must-revalidate sur les HTML

# SW : jamais en cache navigateur
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# Manifest
/manifest.json
  Cache-Control: no-cache
  Content-Type: application/manifest+json; charset=utf-8

# Tout le reste : le SW gère le cache lui-même
# + en-têtes de sécurité (seuls les scripts de l'appli peuvent tourner ; sites extérieurs autorisés :
#   Google Fonts, calendrier.api.gouv.fr, frankfurter.dev, coingecko.com)
/*
  Cache-Control: public, max-age=0
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https://calendrier.api.gouv.fr https://api.frankfurter.dev https://api.coingecko.com https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; manifest-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
